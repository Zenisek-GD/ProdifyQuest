PORT=3000
NODE_ENV=development
# Firebase Console > Project settings > General > Web API key (not the private key).
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to your existing service-account JSON. Never commit that file.
# Forward slashes work on Windows; quotes handle spaces.
GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/service-account.json"
# Browser origins only; native apps do not send an Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
# Set only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=0
